{
  "name": "min-agent-edition",
  "productName": "Min Agent Edition",
  "author": "PalmerAL (fork: Min Agent Edition project)",
  "version": "1.35.7",
  "description": "Min Agent Edition: a separate developer fork of the Min browser adding an agent bridge and MCP browser-automation adapter; distinct from the official Min browser",
  "electronVersion": "43.4.1",
  "main": "main.build.js",
  "standard": {
    "globals": [
      "l",
      "tabs",
      "tasks",
      "globalArgs",
      "platformType",
      "throttle",
      "debounce",
      "empty",
      "alert",
      "confirm",
      "requestAnimationFrame",
      "requestIdleCallback",
      "fetch",
      "localStorage",
      "performance",
      "IntersectionObserver",
      "Node",
      "Event"
    ]
  },
  "dependencies": {
    "@browsermt/bergamot-translator": "^0.4.9",
    "@electron/fuses": "^1.7.0",
    "chokidar": "^3.6.0",
    "dexie": "^3.0.3",
    "dragula": "github:minbrowser/dragula",
    "electron-squirrel-startup": "^1.0.0",
    "expr-eval": "^2.0.2",
    "node-abi": "^3.8.0",
    "papaparse": "^5.5.1",
    "pdfjs-dist": "4.2.67",
    "punycode": "^2.3.1",
    "quick-score": "^0.2.0",
    "regedit": "^3.0.3",
    "sortablejs": "^1.15.1",
    "stemmer": "^1.0.5",
    "write-file-atomic": "^6.0.0"
  },
  "devDependencies": {
    "archiver": "^4.0.1",
    "browserify": "^16.5.1",
    "concurrently": "^5.2.0",
    "decomment": "^0.9.0",
    "electron": "43.4.1",
    "electron-builder": "^24.13.3",
    "electron-installer-windows": "^3.0.0",
    "electron-renderify": "0.0.2",
    "prebuild-install": "^7.0.1",
    "prettier": "^2.2.1",
    "snazzy": "^9.0.0",
    "standard": "^14.3.4"
  },
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "node ./scripts/setupDevEnv.js",
    "test": "standard --verbose js/**/*.js main/*.js",
    "smoke:baseline": "node ./scripts/smoke-baseline.js",
    "test:agent-rpc": "node ./scripts/agent-rpc-test.js",
    "probe:agent-rpc": "node ./scripts/agent-rpc-probe.js",
    "probe:capture": "node ./scripts/capture-page-probe.js",
    "probe:two-url-argv": "node ./scripts/two-url-argv-probe.js",
    "probe:detach": "node ./scripts/detach-probe.js",
    "probe:agent-snapshot": "node ./scripts/agent-snapshot-probe.js",
    "probe:agent-actions": "node ./scripts/agent-actions-probe.js",
    "probe:nps": "node ./scripts/agent-nps-probe.js",
    "launch:agent": "node ./scripts/min-launch.js",
    "watch": "node ./scripts/watch.js",
    "startElectron": "electron . --development-mode",
    "start": "npm run build && concurrently \"npm run watch\" \"npm run startElectron\"",
    "buildMain": "node ./scripts/buildMain.js",
    "buildBrowser": "node ./scripts/buildBrowser.js",
    "buildBrowserStyles": "node ./scripts/buildBrowserStyles.js",
    "buildPreload": "node ./scripts/buildPreload.js",
    "build": "npm run buildMain && npm run buildBrowser && npm run buildBrowserStyles && npm run buildPreload",
    "buildWindows": "npm run build && node ./scripts/buildWindows.js",
    "buildMacIntel": "npm run build && node ./scripts/buildMac.js --platform=x86",
    "buildMacArm": "npm run build && node ./scripts/buildMac.js --platform=arm64",
    "buildDebian": "npm run build && node ./scripts/buildDebian.js --platform=amd64",
    "buildRedhat": "npm run build && node ./scripts/buildRedhat.js",
    "buildAll": "npm run buildWindows && npm run buildMacIntel && npm run buildMacArm && npm run buildDebian && npm run buildRedhat && npm run buildAppImage",
    "buildAppImage": "npm run build && node ./scripts/buildAppImage.js",
    "updateFilters": "node ./ext/filterLists/updateEasylist.js",
    "updateHttpsList": "node ./ext/httpsUpgrade/updateHttpsList.js",
    "updateSuffixes": "node ./ext/publicSuffixes/updateSuffixes.js",
    "lint": "node ./scripts/lint-check.js",
    "lint:style": "node ./scripts/lint-check.js --style",
    "lint:js": "node ./scripts/lint-check.js --js",
    "format:write": "prettier --write \"./**/*.css\" \"./**/*.md\" \"./**/*.html\" \"./**/*.json\" && standard --fix \"js/**/*.js\" \"main/*.js\"",
    "probe:tabs": "node ./scripts/agent-tabs-probe.js",
    "probe:inputs": "node ./scripts/agent-inputs-probe.js",
    "probe:waits": "node ./scripts/agent-waits-probe.js",
    "probe:captcha": "node ./scripts/agent-captcha-probe.js",
    "probe:pav": "node ./scripts/agent-pav-probe.js",
    "probe:downloads": "node ./scripts/agent-downloads-probe.js",
    "probe:mouse": "node ./scripts/agent-mouse-probe.js",
    "probe:transform": "node ./scripts/agent-transform-probe.js",
    "probe:eval": "node ./scripts/agent-eval-probe.js",
    "probe:realweb": "node ./scripts/realweb-accept.js",
    "test:impact": "node ./scripts/test-impact.js",
    "probe:keyboard": "node ./scripts/agent-keyboard-probe.js",
    "probe:helper": "node ./scripts/agent-helper-probe.js",
    "probe:r2": "node ./scripts/agent-r2-probe.js",
    "probe:r4": "node ./scripts/agent-r4-overlay-probe.js"
  }
}
